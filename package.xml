<?xml version="1.0"?>
<package format="2">
  <name>teleop_twist_keyboard</name>
  <version>0.6.0</version>
  <license>BSD</license>
  <description>
    A robot-agnostic teleoperation node to convert keyboard commands to Twist
    messages.
  </description>

  <maintainer email="namniart@gmail.com">Austin Hendrix</maintainer>
  <author>Graylin Trevor Jay</author>

  <url type="website">http://wiki.ros.org/teleop_twist_keyboard</url>
  <url type="development">https://github.com/ros2/teleop_twist_keyboard</url>
  <url type="bugtracker">https://github.com/ros2/teleop_twist_keyboard/issues</url>

  <exec_depend>rclpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
